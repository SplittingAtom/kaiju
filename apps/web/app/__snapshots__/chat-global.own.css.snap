@layer theme, base, kaiju-legacy, components, utilities
body:has([data-kaiju-chat]) {
  margin: 0;
}
@layer base {
  [data-kaiju-chat] *:where(:not([data-kaiju-console], [data-kaiju-console] *)),
  [data-kaiju-chat] :where(:not([data-kaiju-console], [data-kaiju-console] *))::before,
  [data-kaiju-chat] :where(:not([data-kaiju-console], [data-kaiju-console] *))::after,
  [data-slot="tooltip-content"],
  [data-slot="tooltip-content"] * {
    box-sizing: border-box;
    border-color: var(--border);
  }
  [data-kaiju-chat]
    :where(button, input, select, textarea):where(
      :not([data-kaiju-console], [data-kaiju-console] *)
    ) {
    font: inherit;
    color: inherit;
  }
  [data-kaiju-chat] :where(svg):where(:not([data-kaiju-console], [data-kaiju-console] *)) {
    display: block;
  }
  [data-kaiju-chat]
    :where(button[data-slot]):where(:not([data-kaiju-console], [data-kaiju-console] *)) {
    padding: 0;
    border: 0;
    background: transparent;
  }
  [data-kaiju-chat] [data-kaiju-composer-box] {
    anchor-name: --kaiju-composer;
  }
  [data-kaiju-chat]
    :where(button:not(:disabled), [role="button"]:not(:disabled)):where(
      :not([data-kaiju-console], [data-kaiju-console] *)
    ) {
    cursor: pointer;
  }
  [data-kaiju-chat]
    :where(button:not([data-slot])):where(:not([data-kaiju-console], [data-kaiju-console] *)) {
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--kaiju-radius-md);
  }
  [data-kaiju-chat]
    :where(button:not([data-slot]):hover:not(:disabled, [aria-disabled="true"])):where(
      :not([data-kaiju-console], [data-kaiju-console] *)
    ) {
    background: var(--accent);
    color: var(--accent-foreground);
  }
  [data-kaiju-chat]
    :where(button:not([data-slot]):disabled):where(
      :not([data-kaiju-console], [data-kaiju-console] *)
    ) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  [data-kaiju-chat]
    :where(input:not([type="checkbox"], [type="radio"]), select, textarea):where(
      :not([data-kaiju-console], [data-kaiju-console] *)
    ) {
    background: var(--background);
    border: 1px solid var(--input);
    border-radius: var(--kaiju-radius-md);
  }
  [data-kaiju-chat]
    :where(input, select, textarea):where(
      :not([data-kaiju-console], [data-kaiju-console] *)
    ):focus-visible {
    outline: none;
    border-color: var(--ring);
    box-shadow: 0 0 0 3px var(--ring);
    @supports (color: color-mix(in lab, red, red)) {
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--ring) 50%, transparent);
    }
  }
}
@property --kaiju-arrived {
  syntax: "<percentage>";
  inherits: false;
  initial-value: 100%;
}
@keyframes kaiju-arrive {
  from {
    --kaiju-arrived: 0%;
  }
  to {
    --kaiju-arrived: 100%;
  }
}
[data-kaiju-scroll="messages"] {
  --kaiju-arrive-tint: currentColor;
}
[data-kaiju-scroll="messages"][data-kaiju-follow="pinned"] {
  --kaiju-arrive-tint: var(--admin-accent, var(--primary));
}
[data-kaiju-arrive="running"] [data-kaiju-word] {
  color: currentColor;
  @supports (color: color-mix(in lab, red, red)) {
    color: color-mix(in srgb, currentColor var(--kaiju-arrived), var(--kaiju-arrive-tint));
  }
  animation: kaiju-arrive 600ms ease-out;
}
@media (prefers-reduced-motion: reduce) {
  [data-kaiju-arrive="running"] [data-kaiju-word] {
    animation: none;
  }
  [data-kaiju-words] > :is(p, h1, h2, h3, h4, h5, h6, ul, ol) {
    padding-inline-start: 0.5rem;
  }
  [data-kaiju-follow="pinned"] [data-kaiju-arrive="running"] > :last-child {
    box-shadow: inset 2px 0 0 0 var(--kaiju-arrive-tint);
  }
}
[data-kaiju-chat] .kaiju-panel {
  transition: border-color 300ms ease,
    box-shadow 300ms ease;
}
@media (hover: hover) {
  [data-kaiju-chat] .kaiju-panel:hover:not(:has(.kaiju-panel:hover)) {
    border-color: var(--kaiju-panel-border-hover);
    box-shadow: var(--kaiju-glow-panel);
  }
}
@media (prefers-reduced-motion: reduce) {
  [data-kaiju-chat] .kaiju-panel {
    transition: none;
  }
}
@media (forced-colors: active) {
  [data-kaiju-chat] .kaiju-panel:hover:not(:has(.kaiju-panel:hover)) {
    border-color: Highlight;
  }
}
[data-kaiju-chat] [data-kaiju-edge-glow]::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 5;
  pointer-events: none;
  border-radius: var(--kaiju-radius-lg);
}
[data-kaiju-chat] [data-kaiju-edge-glow="waiting"]::after {
  box-shadow: inset 0 0 0 2px var(--kaiju-glow-waiting-border),
    inset 0 0 18px 2px var(--kaiju-glow-waiting);
  animation: kaiju-edge-glow 2.4s ease-in-out infinite alternate;
}
[data-kaiju-chat] [data-kaiju-edge-glow="error"]::after {
  box-shadow: inset 0 0 0 2px var(--kaiju-glow-error-border),
    inset 0 0 18px 2px var(--kaiju-glow-error);
}
@keyframes kaiju-edge-glow {
  from {
    box-shadow: inset 0 0 0 2px var(--kaiju-glow-waiting-border),
      inset 0 0 8px 0 var(--kaiju-glow-waiting);
  }
  to {
    box-shadow: inset 0 0 0 2px var(--kaiju-glow-waiting-border),
      inset 0 0 24px 4px var(--kaiju-glow-waiting);
  }
}
@media (prefers-reduced-motion: reduce) {
  [data-kaiju-chat] [data-kaiju-edge-glow="waiting"]::after {
    animation: none;
  }
}
@media (forced-colors: active) {
  [data-kaiju-chat] [data-kaiju-edge-glow]::after {
    box-shadow: none;
    outline: 2px solid Highlight;
    outline-offset: -2px;
  }
}
[data-kaiju-chat] .kaiju-glow-gold {
  border: 1px solid var(--kaiju-glow-gold-border);
  box-shadow: 0 0 12px 1px var(--kaiju-glow-gold);
  animation: kaiju-glow-gold 2.4s ease-in-out infinite alternate;
}
@keyframes kaiju-glow-gold {
  from {
    box-shadow: 0 0 6px 0 var(--kaiju-glow-gold);
  }
  to {
    box-shadow: 0 0 14px 2px var(--kaiju-glow-gold);
  }
}
@media (prefers-reduced-motion: reduce) {
  [data-kaiju-chat] .kaiju-glow-gold {
    animation: none;
  }
}
@media (forced-colors: active) {
  [data-kaiju-chat] .kaiju-glow-gold {
    border-color: Highlight;
    box-shadow: none;
  }
}
