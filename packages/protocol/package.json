{
  "name": "@kobe/protocol",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kaiju contracts: event stream, sandbox wire, run orchestrator, policy and approvals",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./sandbox-wire": {
      "types": "./dist/sandbox-wire/index.d.ts",
      "default": "./dist/sandbox-wire/index.js"
    },
    "./skill-evals": {
      "types": "./dist/skill-evals/entry.d.ts",
      "default": "./dist/skill-evals/entry.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "yaml": "^2.9.1"
  }
}
